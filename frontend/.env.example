# SYDD Environment Variables (Vercel + Supabase)

# Google Gemini API Key for AI Fitness Assistant
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
# Add this in Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Real-Time Cloud Sync (100% Free Tier)
# Obtain from your Supabase Project Settings -> API (https://supabase.com)
# Add these in Vercel Project Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# (Optional) External backend URL.
# When running everything on Vercel with Supabase (recommended), leave this empty.
# NEXT_PUBLIC_BACKEND_URL=
