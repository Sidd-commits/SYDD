# SYDD Frontend Environment Variables (Vercel Deployment)

# Google Gemini API Key for AI Fitness Assistant
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
# On Vercel: Add this in Project Settings -> Environment Variables. It is kept strictly server-side.
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) External backend URL.
# When running everything on Vercel (recommended), leave this empty or omit it.
# SYDD will automatically use its internal Vercel serverless routes.
# NEXT_PUBLIC_BACKEND_URL=
