# SYDD Backend Environment Variables

# Server port (Render and cloud hosts typically set this automatically)
PORT=5000

# Google Gemini API Key for AI Fitness Assistant
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed origins for CORS (comma-separated list of allowed origins)
# In production, set this to your deployed frontend domain (e.g. https://sydd.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Alternatively, specify FRONTEND_URL or FRONTEND_ORIGIN directly:
# FRONTEND_URL=https://sydd.vercel.app

# Directory for file persistence and backup storage
# In local development: defaults to ./data
# On Render / container with persistent disk: set to the disk mount path (e.g. /var/data or /data)
# DATA_DIR=/var/data
